{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "esnext",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/src/*"]
    },
    "strict": true,
    "resolvePackageJsonExports": true,
    "types": ["node"]
  },
  "include": ["src"],
  "references": [
    {
      "path": "../shared"
    }
  ]
}
